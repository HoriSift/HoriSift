{
  "name": "horisift",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Local-first static analysis of Horizon dependencies in Stellar JavaScript and TypeScript (release candidate, unpublished)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs tests/integration/*.test.mjs tests/regression/*.test.mjs",
    "check:foundation": "node scripts/check-foundation.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "node bin/horisift.mjs",
    "test:stress": "node --experimental-strip-types --test tests/stress/*.test.mjs",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-lint.mjs",
    "build": "tsc -p tsconfig.build.json",
    "smoke:build": "node scripts/check-build.mjs",
    "security:check": "node scripts/check-security.mjs",
    "verify:gates": "node --test tests/quality/*.test.mjs",
    "example": "node scripts/public-example.mjs",
    "test:public": "node --experimental-strip-types --test tests/integration/public-upstream.test.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:audit": "node scripts/check-site.mjs",
    "site:verify": "npm run site:build && npm run site:audit && node --test tests/integration/site.test.mjs",
    "release:pack": "node scripts/verify-release.mjs pack",
    "release:verify": "node scripts/verify-release.mjs verify",
    "readiness:check": "node scripts/release-readiness.mjs",
    "readiness:verify-hold": "node scripts/release-readiness.mjs --expect-hold"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "ajv": "8.20.0"
  },
  "bin": {
    "horisift": "dist/cli/entry.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ]
}
