# Golden output files are byte-exact fixtures. Do not rewrite their LF newlines
# on Windows; the renderer emits LF on every supported operating system.
tests/golden/*.json text eol=lf
tests/golden/*.txt text eol=lf
schemas/*.json text eol=lf
# Prevent platform checkout transformations of source/policy inputs used by CI.
*.ts text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
# Real upstream-source snapshots have fixed checked blob SHA-1 and SHA-256.
tests/fixtures/public-upstream/*.source text eol=lf
